---
import BaseLayout from "./BaseLayout.astro";
import DocsNav from "../components/DocsNav.astro";
import Icon from "../components/Icon.astro";
import { navigation, type Accent } from "../lib/site";
import { sourceUrl, url } from "../lib/urls";
import "../styles/docs.css";

interface Props {
  title: string;
  description: string;
  section?: string;
  accent?: Accent;
  source: string;
}

const { title, description, section = "Documentation", accent = "slate", source } = Astro.props;
const links = navigation.flatMap((group) => [...group.links]);
const index = links.findIndex((link) => url(link.path) === Astro.url.pathname);
const previous = index > 0 ? links[index - 1] : undefined;
const next = index >= 0 ? links[index + 1] : undefined;
---

<BaseLayout title={title} description={description} accent={accent}>
  <div class="docs-frame">
    <DocsNav title={title} />
    <main class="docs-main" id="main-content" tabindex="-1">
      <header class="docs-page-header">
        <p class="lf-kicker">{section}</p>
        <h1>{title}</h1>
        <p class="docs-description">{description}</p>
      </header>
      <div class="docs-content">
        <slot />
      </div>
      <footer class="docs-page-footer">
        <a class="docs-edit-link" href={sourceUrl(source, true)}>
          Edit this page on GitHub <Icon name="external-link" />
        </a>
        <nav class="docs-pagination" aria-label="Documentation pages">
          {
            previous && (
              <a class="docs-page-link" href={url(previous.path)}>
                <span>
                  <Icon name="arrow-left" /> Previous
                </span>
                <strong>{previous.title}</strong>
              </a>
            )
          }
          {
            next && (
              <a class="docs-page-link docs-page-link-next" href={url(next.path)}>
                <span>
                  Next <Icon name="arrow-right" />
                </span>
                <strong>{next.title}</strong>
              </a>
            )
          }
        </nav>
      </footer>
    </main>
  </div>
</BaseLayout>

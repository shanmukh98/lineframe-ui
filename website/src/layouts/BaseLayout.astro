---
import "../styles/fonts.css";
import "../styles/site.css";
import "../styles/code.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, type Accent } from "../lib/site";
import { asset, url } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  accent?: Accent;
  noindex?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description = site.description,
  accent = "slate",
  noindex = false,
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const pageTitle =
  title === site.name ? `${site.name} — A quiet frame for your content` : `${title} · ${site.name}`;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL(url("social-card.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Lineframe UI. A quiet frame for your content." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src={asset("lineframe-theme.js")}></script>
    <link rel="stylesheet" href={asset("lineframe.css")} />
    <script is:inline src={asset("lineframe-toc.js")} defer></script>
    <slot name="head" />
  </head>
  <body class="lf-site site-body" data-lineframe-accent={accent}>
    <a class="lf-skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <script>
      import { initSite } from "../scripts/site";

      initSite();
    </script>
  </body>
</html>
